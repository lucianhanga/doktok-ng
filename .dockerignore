# Keep image build contexts small and free of secrets/data (M11 #317).
.git
.github
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
.venv
**/.venv
node_modules
**/node_modules
apps/ui/dist
dist
build
# Local data + secrets must never enter an image.
storage/files
# Local backup repos (restic/pgBackRest, written by root via the systemd timers) - huge and
# unreadable to the build client; excluding them keeps `docker compose build` working (#fix).
backups
.env
.env.*
*.log
