[Unit]
Description=DokTok offsite sync (push the local backup repo to Azure Blob)
Documentation=https://github.com/lucianhanga/doktok-ng/blob/main/deploy/systemd/README.md
After=docker.service doktok-backup-diff.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/doktok
EnvironmentFile=/etc/doktok/backup.env
ExecStart=/opt/doktok/deploy/azure-sync.sh
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
